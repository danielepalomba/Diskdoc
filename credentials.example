# Example of ~/.config/diskdoc/credentials
#
# Do not edit this file: run 'diskdoc --set-key <openai|anthropic|gemini>',
# which reads the key from the terminal and writes it with mode 0600.
# diskdoc refuses to read the file if anyone but its owner can.
#
# With more than one key stored, pick the one -i uses by adding a line
#   DISKDOC_PROVIDER=openai
# here, or by exporting DISKDOC_PROVIDER. Note that sudo wipes the environment,
# so the line in this file is what survives 'sudo diskdoc -i'.
# To keep the key out of any file, export DISKDOC_API_KEY_CMD instead, e.g.
#   export DISKDOC_PROVIDER=openai
#   export DISKDOC_API_KEY_CMD='pass show openai/api'

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
